# Environment Configuration for Amritha Ayurveda App

# Base API URL
BASE_URL=https://flutter-amr.noviindus.in

# API Endpoints
LOGIN_ENDPOINT=/api/Login
PATIENT_LIST_ENDPOINT=/api/PatientList
PATIENT_UPDATE_ENDPOINT=/api/PatientUpdate
TREATMENT_LIST_ENDPOINT=/api/TreatmentList
BRANCH_LIST_ENDPOINT=/api/BranchList

# App Configuration
APP_NAME=Amritha Ayurveda
APP_VERSION=1.0.0

# Debug Configuration
DEBUG_MODE=true
ENABLE_LOGGING=true

# Timeout Configuration (in seconds)
CONNECTION_TIMEOUT=30
RECEIVE_TIMEOUT=30
SEND_TIMEOUT=30

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
